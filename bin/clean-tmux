#!/bin/bash

set -euo pipefail

# 全 tmux セッションの kill と tmux-resurrect 保存データの削除を行う。
# 非可逆な操作のため、--force / -f 指定時以外は確認プロンプトを出す。
if [ "${1:-}" != "--force" ] && [ "${1:-}" != "-f" ]; then
    echo "This will kill ALL tmux sessions and delete saved sessions (tmux-resurrect)."
    read -r -p "Continue? [y/N]: " answer
    case "$answer" in
        y|Y|yes) ;;
        *) echo "Aborted."; exit 0 ;;
    esac
fi

echo "Cleaning tmux sessions..."

# Kill all tmux sessions
if tmux list-sessions >/dev/null 2>&1; then
    tmux kill-server
    echo "All tmux sessions killed."
else
    echo "No active tmux sessions."
fi

# Remove tmux-resurrect saved sessions.
# tmux-resurrect は ~/.tmux/resurrect が存在すればそこを、存在しなければ XDG の
# パス($XDG_DATA_HOME/tmux/resurrect、既定は ~/.local/share/tmux/resurrect)を
# 保存先にする(tmux-resurrect の scripts/helpers.sh)。新規に構築した環境では
# 後者になるため、どちらのレイアウトでも掃除できるよう両方を対象にする。
# なお @resurrect-dir で保存先を明示している場合は対象外。
removed=0
for resurrect_dir in \
    "$HOME/.tmux/resurrect" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"; do
    if [ -d "$resurrect_dir" ]; then
        rm -rf "$resurrect_dir"
        echo "Removed saved sessions: $resurrect_dir"
        removed=1
    fi
done

if [ "$removed" -eq 0 ]; then
    echo "No saved sessions found."
fi

echo "Done. tmux is now clean."
